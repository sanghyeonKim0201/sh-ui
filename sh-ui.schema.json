{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sh-ui Design System Config",
  "description": "sh-ui.config.json — CLI가 이 설정을 읽어 토큰/컴포넌트 소스를 변환해 복사한다.",
  "type": "object",
  "required": ["platform", "theme", "paths"],
  "properties": {
    "$schema": { "type": "string" },
    "platform": {
      "description": "대상 플랫폼",
      "enum": ["react", "flutter"]
    },
    "style": {
      "description": "스타일 프리셋 (기본: default)",
      "enum": ["default"],
      "default": "default"
    },
    "theme": {
      "type": "object",
      "required": ["base", "radius", "mode"],
      "properties": {
        "base": {
          "description": "기본 무채색 스케일",
          "enum": ["neutral", "zinc", "slate"],
          "default": "neutral"
        },
        "radius": {
          "description": "기본 모서리 radius",
          "enum": ["none", "sm", "md", "lg", "xl", "full"],
          "default": "md"
        },
        "mode": {
          "description": "라이트/다크 모드 생성 방식",
          "enum": ["light", "dark", "light-dark"],
          "default": "light-dark"
        }
      }
    },
    "paths": {
      "type": "object",
      "description": "사용자 프로젝트 내 대상 경로 (CLI가 여기로 파일 복사)",
      "properties": {
        "tokens":     { "type": "string" },
        "components": { "type": "string" },
        "utils":      { "type": "string" }
      }
    },
    "aliases": {
      "type": "object",
      "description": "import 경로 alias (React 한정)",
      "properties": {
        "components": { "type": "string" },
        "utils":      { "type": "string" },
        "ui":         { "type": "string" }
      }
    }
  }
}
