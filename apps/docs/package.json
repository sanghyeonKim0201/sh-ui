{
  "name": "@sh-ui/docs",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-search-index.mjs && node scripts/generate-variants.mjs",
    "dev": "next dev",
    "prebuild": "pnpm --filter @sh-ui/llms gen && node scripts/build-search-index.mjs && node scripts/generate-variants.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pretypecheck": "node scripts/generate-variants.mjs",
    "typecheck": "tsc --noEmit",
    "generate:variants": "node scripts/generate-variants.mjs",
    "visual": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "sh-ui:install": "node ../../packages/cli/bin/sh-ui.mjs add tokens button"
  },
  "dependencies": {
    "@base-ui/react": "latest",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@tanstack/react-form": "^1.29.1",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "codemirror": "^6.0.2",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.14.0",
    "minisearch": "^7.1.2",
    "next": "^16.2.3",
    "next-intl": "^4.11.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sh-ui-cli": "workspace:*",
    "shiki": "latest",
    "yup": "^1.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.0"
  }
}
