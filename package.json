{
  "name": "sh-ui",
  "version": "0.7.0",
  "private": true,
  "description": "sh-ui — 김상현 개인 디자인 시스템.",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "gen:llms": "pnpm --filter @sh-ui/llms gen",
    "lint:registry": "node scripts/lint-registry.mjs",
    "lint:dual-copy": "node scripts/lint-dual-copy.mjs",
    "lint:tokens-used": "node scripts/build-registry-tokens.mjs --check",
    "build:tokens-used": "node scripts/build-registry-tokens.mjs",
    "lint:drift": "pnpm lint:registry && pnpm lint:dual-copy && pnpm lint:tokens-used",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "release": "node scripts/release.mjs",
    "showcase": "open -a Simulator && cd apps/showcase && flutter run",
    "showcase:ios": "open -a Simulator && cd apps/showcase && flutter run -d iphone",
    "showcase:web": "cd apps/showcase && flutter run -d chrome",
    "showcase:mac": "cd apps/showcase && flutter run -d macos"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^5.9.0",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
