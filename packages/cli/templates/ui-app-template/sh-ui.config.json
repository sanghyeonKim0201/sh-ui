{
  "$schema": "https://raw.githubusercontent.com/sanghyeonKim0201/sh-ui/live/packages/cli/sh-ui.schema.json",
  "platform": "react",
  "cssFramework": "plain",
  "role": "tokens-only",
  "theme": {
    "base": "neutral",
    "radius": "md",
    "mode": "light-dark"
  },
  "paths": {
    "tokens": "src/styles/tokens.css",
    "cssEntry": "src/styles/globals.css",
    "styles": "src/styles"
  }
}
