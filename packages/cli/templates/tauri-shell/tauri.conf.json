{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{project_name}}",
  "version": "0.1.0",
  "identifier": "app.{{tauri_crate_name}}.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "{{tauri_dev_url}}",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "{{project_name}}",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
